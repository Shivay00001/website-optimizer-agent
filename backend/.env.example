# Copy to .env and fill in. Dummy values are fine for local dev;
# never commit real keys. All non-public API endpoints require X-API-Key.

# Shared secret the backend requires in the `X-API-Key` request header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=dev-dummy-key-change-me

# LLM provider keys (at least one required for real audits; also accepted
# per-request via X-OpenAI-Key / X-Anthropic-Key / X-Gemini-Key / X-GLM-Key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZHIPUAI_API_KEY=

# Local Ollama server base URL (used for model ids starting with ollama/)
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated list of allowed browser origins (CORS). No wildcards.
CORS_ORIGINS=http://localhost:3000

# SQLite default; use postgresql+asyncpg://user:pass@host/db on Render etc.
DATABASE_URL=sqlite+aiosqlite:///./optimizer.db

# Dev/test only — NEVER set in production. Skips the SSRF private-IP check
# (useful in sandboxed CI where DNS resolves everything to proxy IPs).
DISABLE_SSRF_GUARD=

# Audit job tuning
MAX_HTML_CHARS=15000
FETCH_TIMEOUT_SECONDS=15
LITELLM_MAX_TOKENS=2000
